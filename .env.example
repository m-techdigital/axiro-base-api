APP_NAME="AXIRO Base API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://127.0.0.1:5173
FRONTEND_URLS=http://127.0.0.1:5173,http://127.0.0.1:5174
FRONTEND_ORIGIN_PATTERN="#^http://(127\.0\.0\.1|localhost)(:\d+)?$#"
LOG_CHANNEL=stack
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
JWT_SECRET=
JWT_TTL=60
CUSTOMER_AUTH_ACCESS_TTL_MINUTES=43200
AUTH_REFRESH_COOKIE_TTL_DAYS=30
AUTH_REFRESH_COOKIE=refresh_token
AUTH_REFRESH_COOKIE_TTL_DAYS=30
ADMIN_USERNAME=admin
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

CUSTOMER_USERNAME=customer
CUSTOMER_NAME="Demo Customer"
CUSTOMER_EMAIL=customer@example.com
CUSTOMER_PHONE=0900000000
CUSTOMER_PASSWORD=change-me
CUSTOMER_AUTH_REFRESH_COOKIE=customer_refresh_token

# Mật khẩu chung cho các tài khoản khách hàng dữ liệu mẫu
DEMO_CUSTOMER_PASSWORD=change-me
# Marketplace document operator
MARKETPLACE_OPERATOR_NAME="CÔNG TY/ĐƠN VỊ VẬN HÀNH MBN"
MARKETPLACE_OPERATOR_TAX_CODE="ĐANG CẬP NHẬT"
MARKETPLACE_OPERATOR_ADDRESS="ĐANG CẬP NHẬT"
MARKETPLACE_SUPPORT_PHONE="ĐANG CẬP NHẬT"
MARKETPLACE_SUPPORT_EMAIL=support@example.com
MARKETPLACE_WEBSITE=https://example.com
MARKETPLACE_POLICY_VERSION=2026.07

# Audit history retention
AUDIT_RETENTION_DAYS=365
AUDIT_VALIDATION_RETENTION_DAYS=90

MARKETPLACE_BANK_ID=MB
MARKETPLACE_BANK_NAME=MB BANK
MARKETPLACE_BANK_ACCOUNT_NO=0123456789
MARKETPLACE_BANK_ACCOUNT_NAME=NGUYEN VAN A
MARKETPLACE_BANK_QR_TEMPLATE=compact2
MARKETPLACE_BANK_TRANSFER_PREFIX=MBN

# Refresh token cookie hardening. Enable secure cookies on HTTPS deployments.
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=lax
