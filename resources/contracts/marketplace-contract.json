  "escrow_box_contract": {
    "owner": "escrow_boxes",
    "requires_public_listing": false,
    "identity_exposure": "admin_only",
    "customer_aliases": [
      "Bên A",
      "Bên B"
    ],
    "invite": {
      "opaque_token": true,
      "stored_as_hash": true,
      "single_claim": true,
      "invalidated_after_claim": true
    },
    "agreement": {
      "versioned": true,
      "both_parties_same_version": true,
      "confirmation_resets_after_change": true
    },
    "fees": {
      "default_base_fee": "50000.00",
      "default_percentage_rate": "10.0000",
      "admin_override_requires_reason": true,
      "snapshot_on_approval": true
    },
    "payment": {
      "created_after_admin_approval": true,
      "supports_equal_exchange": true,
      "supports_topup": true,
      "supports_split_fee": true
    },
    "handover": {
      "admin_sequence": [
        "party_a_first",
        "party_b_first",
        "simultaneous_admin_observed"
      ],
      "evidence_required": true,
      "inspection_after_both_verified": true
    },
    "media": {
      "private_disk": true,
      "exif_removed_by_reencode": true,
      "max_edge": 1920,
      "thumbnail_edge": 480,
      "dedupe_checksum": true,
      "retention_lock_on_dispute": true
    },
    "reuses": [
      "transaction_payment",
      "wallet_ledger",
      "transaction_settlement",
      "transaction_dispute",
      "document",
      "payout"
    ],
    "admin_assigned_box": {
      "admin_selects_two_customers": true,
      "separate_invite_per_party": true,
      "invite_bound_to_assigned_customer": true,
      "third_party_gets_generic_not_found": true,
      "both_parties_accept_same_version_before_admin_review": true,
      "raw_tokens_returned_once": true,
      "unaccepted_invites_can_be_rotated": true
    }
  }
